using System;

namespace ConsoleAppTask3
{
    public class Task3
    {
        // 1. Числа подряд
        public string listNums(int x)
        {
            string s = "";
            if (x >= 0)
                for (int i = 0; i <= x; i++) s += i + " ";
            else
                for (int i = 0; i >= x; i--) s += i + " ";
            return s.Trim();
        }

        // 3. Четные числа
        public string chet(int x)
        {
            string s = "";
            if (x >= 0)
                for (int i = 0; i <= x; i += 2) s += i + " ";
            else
                for (int i = 0; i >= x; i -= 2) s += i + " ";
            return s.Trim();
        }

        // 5. Длина числа
        public int numLen(long x)
        {
            if (x == 0) return 1;
            if (x < 0) x = -x;

            int len = 0;
            while (x > 0)
            {
                len++;
                x /= 10;
            }
            return len;
        }

        // 7. Квадрат
        public void square(int x)
        {
            for (int i = 0; i < x; i++)
            {
                for (int j = 0; j < x; j++)
                    Console.Write("*");
                Console.WriteLine();
            }
        }

        // 9. Правый треугольник
        public void rightTriangle(int x)
        {
            for (int i = 1; i <= x; i++)
            {
                for (int j = 1; j <= x - i; j++)
                    Console.Write(" ");
                for (int j = 1; j <= i; j++)
                    Console.Write("*");
                Console.WriteLine();
            }
        }

        public static void Main()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            Task3 t = new Task3();

            Console.WriteLine("Числа подряд:");
            Console.WriteLine("listNums(5) = " + t.listNums(5));
            Console.WriteLine("listNums(-3) = " + t.listNums(-3));
            Console.WriteLine();

            Console.WriteLine("Четные числа:");
            Console.WriteLine("chet(9) = " + t.chet(9));
            Console.WriteLine("chet(-5) = " + t.chet(-5));
            Console.WriteLine();

            Console.WriteLine("Длина числа:");
            Console.WriteLine("numLen(12567) = " + t.numLen(12567));
            Console.WriteLine("numLen(123) = " + t.numLen(123));
            Console.WriteLine();

            Console.WriteLine("Квадрат:");
            Console.WriteLine("square(7):");
            t.square(7);
            Console.WriteLine("square(4):");
            t.square(4);
            Console.WriteLine();

            Console.WriteLine("Правый треугольник:");
            Console.WriteLine("rightTriangle(3):");
            t.rightTriangle(3);
            Console.WriteLine("rightTriangle(4):");
            t.rightTriangle(4);
            Console.WriteLine();

            Console.ReadKey();
        }
    }
}
