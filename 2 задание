using System;

namespace ConsoleAppTask2
{
    public class Task2
    {
        public int abs(int x)
        {
            return x < 0 ? -x : x;
        }

        public bool is35(int x)
        {
            bool d3 = x % 3 == 0;
            bool d5 = x % 5 == 0;
            return (d3 || d5) && !(d3 && d5);
        }

        public int max3(int x, int y, int z)
        {
            int max = x;
            if (y > max) max = y;
            if (z > max) max = z;
            return max;
        }

        public int sum2(int x, int y)
        {
            int s = x + y;
            if (s >= 10 && s <= 19) return 20;
            return s;
        }

        public string day(int x)
        {
            switch (x)
            {
                case 1: return "понедельник";
                case 2: return "вторник";
                case 3: return "среда";
                case 4: return "четверг";
                case 5: return "пятница";
                case 6: return "суббота";
                case 7: return "воскресенье";
                default: return "это не день недели";
            }
        }

        

        private static int ReadInt(string prompt)
        {
            int result;
            while (true)
            {
                Console.Write(prompt);
                string input = Console.ReadLine();
                if (int.TryParse(input, out result))
                {
                    return result;
                }
                Console.WriteLine("Ошибка! Введите целое число.");
            }
        }

        public static void Main()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;
            Task2 t = new Task2();

            Console.WriteLine("--- Задача 1. Модуль числа ---");
            int x1 = ReadInt("Введите число x: ");
            Console.WriteLine($"Результат: {t.abs(x1)}");

            Console.WriteLine("\n--- Задача 3. Тридцать пять ---");
            int x3 = ReadInt("Введите число x: ");
            Console.WriteLine($"Результат: {t.is35(x3)}");

            Console.WriteLine("\n--- Задача 5. Тройной максимум ---");
            int x5 = ReadInt("Введите число x: ");
            int y5 = ReadInt("Введите число y: ");
            int z5 = ReadInt("Введите число z: ");
            Console.WriteLine($"Результат: {t.max3(x5, y5, z5)}");

            Console.WriteLine("\n--- Задача 7. Двойная сумма ---");
            int x7 = ReadInt("Введите число x: ");
            int y7 = ReadInt("Введите число y: ");
            Console.WriteLine($"Результат: {t.sum2(x7, y7)}");

            Console.WriteLine("\n--- Задача 9. День недели ---");
            int x9;
            do
            {
                x9 = ReadInt("Введите число от 1 до 7: ");
                if (x9 < 1 || x9 > 7)
                {
                    Console.WriteLine("Ошибка! Число должно быть от 1 до 7.");
                }
            } while (x9 < 1 || x9 > 7);
            Console.WriteLine($"Результат: {t.day(x9)}");

            Console.ReadKey();
        }
    }
}
