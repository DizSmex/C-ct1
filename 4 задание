using System;

public class Task4
{
    // 1. Поиск первого значения
    public int findFirst(int[] arr, int x)
    {
        for (int i = 0; i < arr.Length; i++)
            if (arr[i] == x) return i;
        return -1;
    }

    // 3. Поиск максимального по модулю
    public int maxAbs(int[] arr)
    {
        int best = arr[0];
        for (int i = 1; i < arr.Length; i++)
            if (Math.Abs(arr[i]) > Math.Abs(best))
                best = arr[i];
        return best;
    }

    // 5. Добавление массива в массив
    public int[] add(int[] arr, int[] ins, int pos)
    {
        int[] res = new int[arr.Length + ins.Length];

        for (int i = 0; i < pos; i++)
            res[i] = arr[i];

        for (int i = 0; i < ins.Length; i++)
            res[pos + i] = ins[i];

        for (int i = pos; i < arr.Length; i++)
            res[ins.Length + i] = arr[i];

        return res;
    }

    // 7. Возвратный реверс
    public int[] reverseBack(int[] arr)
    {
        int[] res = new int[arr.Length];
        for (int i = 0; i < arr.Length; i++)
            res[i] = arr[arr.Length - 1 - i];
        return res;
    }

    // 9. Все вхождения
    public int[] findAll(int[] arr, int x)
    {
        int count = 0;
        for (int i = 0; i < arr.Length; i++)
            if (arr[i] == x) count++;

        int[] res = new int[count];
        int k = 0;
        for (int i = 0; i < arr.Length; i++)
            if (arr[i] == x) res[k++] = i;

        return res;
    }

    public static void Main()
    {
        Console.OutputEncoding = System.Text.Encoding.UTF8;

        Task4 t = new Task4();

        Console.WriteLine("Поиск первого значения:");
        Console.WriteLine("findFirst([1,2,3,4,2,2,5], 2) = " + t.findFirst(new int[] { 1, 2, 3, 4, 2, 2, 5 }, 2));
        Console.WriteLine("findFirst([1,2,3,4,2,2,5], 5) = " + t.findFirst(new int[] { 1, 2, 3, 4, 2, 2, 5 }, 5));
        Console.WriteLine();

        Console.WriteLine("Поиск максимального по модулю:");
        Console.WriteLine("maxAbs([1,-2,-7,4,2,2,5]) = " + t.maxAbs(new int[] { 1, -2, -7, 4, 2, 2, 5 }));
        Console.WriteLine("maxAbs([-10,2,3]) = " + t.maxAbs(new int[] { -10, 2, 3 }));
        Console.WriteLine();

        Console.WriteLine("Добавление массива в массив:");
        Console.WriteLine("add([1,2,3,4,5], [7,8,9], 3) = " + string.Join(" ", t.add(new int[] { 1, 2, 3, 4, 5 }, new int[] { 7, 8, 9 }, 3)));
        Console.WriteLine("add([1,2], [3,4], 1) = " + string.Join(" ", t.add(new int[] { 1, 2 }, new int[] { 3, 4 }, 1)));
        Console.WriteLine();

        Console.WriteLine("Возвратный реверс:");
        Console.WriteLine("reverseBack([1,2,3,4,5]) = " + string.Join(" ", t.reverseBack(new int[] { 1, 2, 3, 4, 5 })));
        Console.WriteLine("reverseBack([7,8,9]) = " + string.Join(" ", t.reverseBack(new int[] { 7, 8, 9 })));
        Console.WriteLine();

        Console.WriteLine("Все вхождения:");
        Console.WriteLine("findAll([1,2,3,8,2,2,9], 2) = " + string.Join(" ", t.findAll(new int[] { 1, 2, 3, 8, 2, 2, 9 }, 2)));
        Console.WriteLine("findAll([5,5,5], 5) = " + string.Join(" ", t.findAll(new int[] { 5, 5, 5 }, 5)));
        Console.WriteLine();

        Console.ReadKey();
    }
}
