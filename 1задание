using System;

public class Task1
{
    // 1. Дробная часть
    public double fraction(double x)
    {
        return x - (int)x;
    }

    // 3. Букву в число
    public int charToNum(char x)
    {
        return x - '0';
    }

    // 5. Двузначное
    public bool is2Digits(int x)
    {
        x = Math.Abs(x);
        return x >= 10 && x <= 99;
    }

    // 7. Диапазон
    public bool isInRange(int a, int b, int num)
    {
        return num >= Math.Min(a, b) && num <= Math.Max(a, b);
    }

    // 9. Равенство
    public bool isEqual(int a, int b, int c)
    {
        return a == b && b == c;
    }

    public static void Main()
    {
        Console.OutputEncoding = System.Text.Encoding.UTF8;
        Task1 t = new Task1();

        Console.WriteLine("Дробная часть:");
        Console.WriteLine("fraction(5.25) = " + t.fraction(5.25));
        Console.WriteLine("fraction(10.75) = " + t.fraction(10.75));
        Console.WriteLine();

        Console.WriteLine("Букву в число:");
        Console.WriteLine("charToNum('3') = " + t.charToNum('3'));
        Console.WriteLine("charToNum('7') = " + t.charToNum('7'));
        Console.WriteLine();

        Console.WriteLine("Двузначное:");
        Console.WriteLine("is2Digits(32) = " + t.is2Digits(32));
        Console.WriteLine("is2Digits(516) = " + t.is2Digits(516));
        Console.WriteLine();

        Console.WriteLine("Диапазон:");
        Console.WriteLine("isInRange(5, 1, 3) = " + t.isInRange(5, 1, 3));
        Console.WriteLine("isInRange(2, 15, 33) = " + t.isInRange(2, 15, 33));
        Console.WriteLine();

        Console.WriteLine("Равенство:");
        Console.WriteLine("isEqual(3, 3, 3) = " + t.isEqual(3, 3, 3));
        Console.WriteLine("isEqual(2, 15, 2) = " + t.isEqual(2, 15, 2));
        Console.WriteLine();

        Console.ReadKey();
    }
}
