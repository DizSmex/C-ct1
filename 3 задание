using System;

namespace ConsoleAppTask3
{
    public class Task3
    {
        public string listNums(int x)
        {
            string s = "";
            if (x >= 0)
                for (int i = 0; i <= x; i++) s += i + " ";
            else
                for (int i = 0; i >= x; i--) s += i + " ";
            return s.Trim();
        }

        public string chet(int x)
        {
            string s = "";
            if (x >= 0)
                for (int i = 0; i <= x; i += 2) s += i + " ";
            else
                for (int i = 0; i >= x; i -= 2) s += i + " ";
            return s.Trim();
        }

        public int numLen(long x)
        {
            if (x == 0) return 1;
            if (x < 0) x = -x;

            int len = 0;
            while (x > 0)
            {
                len++;
                x /= 10;
            }
            return len;
        }

        public void square(int x)
        {
            for (int i = 0; i < x; i++)
            {
                for (int j = 0; j < x; j++)
                    Console.Write("*");
                Console.WriteLine();
            }
        }

        public void rightTriangle(int x)
        {
            for (int i = 1; i <= x; i++)
            {
                for (int j = 1; j <= x - i; j++)
                    Console.Write(" ");
                for (int j = 1; j <= i; j++)
                    Console.Write("*");
                Console.WriteLine();
            }
        }

        // ================= ВСПОМОГАТЕЛЬНЫЕ МЕТОДЫ =================

        private static int ReadInt(string prompt)
        {
            int result;
            while (true)
            {
                Console.Write(prompt);
                string input = Console.ReadLine();
                if (int.TryParse(input, out result))
                {
                    return result;
                }
                Console.WriteLine("Ошибка! Введите целое число.");
            }
        }

        private static long ReadLong(string prompt)
        {
            long result;
            while (true)
            {
                Console.Write(prompt);
                string input = Console.ReadLine();
                if (long.TryParse(input, out result))
                {
                    return result;
                }
                Console.WriteLine("Ошибка! Введите целое число.");
            }
        }

        public static void Main()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;
            Task3 t = new Task3();

            Console.WriteLine("--- Задача 1. Числа подряд ---");
            int x1 = ReadInt("Введите число x: ");
            Console.WriteLine($"Результат: {t.listNums(x1)}");

            Console.WriteLine("\n--- Задача 3. Четные числа ---");
            int x3 = ReadInt("Введите число x: ");
            Console.WriteLine($"Результат: {t.chet(x3)}");

            Console.WriteLine("\n--- Задача 5. Длина числа ---");
            long x5 = ReadLong("Введите число x: ");
            Console.WriteLine($"Результат: {t.numLen(x5)}");

            Console.WriteLine("\n--- Задача 7. Квадрат ---");
            int x7;
            do
            {
                x7 = ReadInt("Введите размер квадрата (x > 0): ");
                if (x7 <= 0) Console.WriteLine("Ошибка! Число должно быть больше 0.");
            } while (x7 <= 0);
            Console.WriteLine("Результат:");
            t.square(x7);

            Console.WriteLine("\n--- Задача 9. Правый треугольник ---");
            int x9;
            do
            {
                x9 = ReadInt("Введите высоту треугольника (x > 0): ");
                if (x9 <= 0) Console.WriteLine("Ошибка! Число должно быть больше 0.");
            } while (x9 <= 0);
            Console.WriteLine("Результат:");
            t.rightTriangle(x9);

            Console.ReadKey();
        }
    }
}
