using System;

namespace ConsoleAppTask2
{
    public class Task2
    {
        // 1. Модуль числа
        public int abs(int x)
        {
            return x < 0 ? -x : x;
        }

        // 3. Тридцать пять
        public bool is35(int x)
        {
            bool d3 = x % 3 == 0;
            bool d5 = x % 5 == 0;
            return (d3 || d5) && !(d3 && d5);
        }

        // 5. Тройной максимум
        public int max3(int x, int y, int z)
        {
            int max = x;
            if (y > max) max = y;
            if (z > max) max = z;
            return max;
        }

        // 7. Двойная сумма
        public int sum2(int x, int y)
        {
            int s = x + y;
            if (s >= 10 && s <= 19) return 20;
            return s;
        }

        // 9. День недели
        public string day(int x)
        {
            switch (x)
            {
                case 1: return "понедельник";
                case 2: return "вторник";
                case 3: return "среда";
                case 4: return "четверг";
                case 5: return "пятница";
                case 6: return "суббота";
                case 7: return "воскресенье";
                default: return "это не день недели";
            }
        }

        public static void Main()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            Task2 t = new Task2();

            Console.WriteLine("Модуль числа:");
            Console.WriteLine("abs(-3) = " + t.abs(-3));
            Console.WriteLine("abs(5) = " + t.abs(5));
            Console.WriteLine();

            Console.WriteLine("Тридцать пять:");
            Console.WriteLine("is35(5) = " + t.is35(5));
            Console.WriteLine("is35(15) = " + t.is35(15));
            Console.WriteLine();

            Console.WriteLine("Тройной максимум:");
            Console.WriteLine("max3(5, 7, 7) = " + t.max3(5, 7, 7));
            Console.WriteLine("max3(8, -1, 4) = " + t.max3(8, -1, 4));
            Console.WriteLine();

            Console.WriteLine("Двойная сумма:");
            Console.WriteLine("sum2(5, 7) = " + t.sum2(5, 7));
            Console.WriteLine("sum2(8, -1) = " + t.sum2(8, -1));
            Console.WriteLine();

            Console.WriteLine("День недели:");
            Console.WriteLine("day(5) = " + t.day(5));
            Console.WriteLine("day(0) = " + t.day(0));
            Console.WriteLine();

            Console.ReadKey();
        }
    }
}
